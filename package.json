{
  "name": "local-api-proxy",
  "version": "0.1.1",
  "description": "Local dev proxy on Bun that puts remote APIs behind their own https://*.localhost domains via portless, with local CORS, cookie and redirect rewrites, WebSockets, and a small web UI.",
  "author": "Harry <thedv91@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedv91/local-proxy.git"
  },
  "homepage": "https://github.com/thedv91/local-proxy#readme",
  "bugs": {
    "url": "https://github.com/thedv91/local-proxy/issues"
  },
  "keywords": [
    "bun",
    "proxy",
    "reverse-proxy",
    "cors",
    "localhost",
    "https",
    "websocket",
    "portless"
  ],
  "type": "module",
  "bin": {
    "local-proxy": "bin/local-proxy.ts"
  },
  "files": [
    "bin",
    "!bin/*.test.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/web/test-dom.ts",
    "dist"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "happy-dom": "^20.14.5",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2"
  }
}
